+        g = torch.randn_like(y) * 0.1
+        actual = torch.autograd.grad(y, xs, g)
+        expected = torch.autograd.grad(ref, refs, g)
+        errors = []
+        for a, b in [(y, ref), *zip(actual, expected)]:
+            self.assertEqual(a, b, atol=0.03, rtol=0.05)
+            error = float(
