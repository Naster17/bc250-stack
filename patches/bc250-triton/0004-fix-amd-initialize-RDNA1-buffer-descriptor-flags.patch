From ee65ff3b85f99d52e678b252a99c8425fa46e329 Mon Sep 17 00:00:00 2001
From: Naster17 <naster17.dev@gmail.com>
Date: Mon, 12 Oct 2026 13:38:12 +0200
Subject: [PATCH] fix(amd): initialize RDNA1 buffer descriptor flags

Include RDNA1 in the RDNA descriptor-format and bounds-mode branch. Without these fields, gfx1013 buffer-based kernels return incorrect results while the same GPU tests pass with global memory operations.

Validation: pre-commit passes. Native rebuild and buffer-enabled hardware regression follow on the BC-250 host.
---
 third_party/amd/lib/TritonAMDGPUToLLVM/BufferOpsEmitter.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/third_party/amd/lib/TritonAMDGPUToLLVM/BufferOpsEmitter.cpp b/third_party/amd/lib/TritonAMDGPUToLLVM/BufferOpsEmitter.cpp
index 7e913ca..c2c0cc7 100644
--- a/third_party/amd/lib/TritonAMDGPUToLLVM/BufferOpsEmitter.cpp
+++ b/third_party/amd/lib/TritonAMDGPUToLLVM/BufferOpsEmitter.cpp
@@ -68,8 +68,8 @@ Value BufferEmitter::createResourceDescriptor(Value basePtr,
   // The RDNA-style flags below have bits [3:0]=0, so they are effectively
   // ignored on GFX12+ but we include GFX1250 in the check for consistency.
   uint32_t flags = (7 << 12) | (4 << 15);
-  if (llvm::is_contained({ISAFamily::RDNA2, ISAFamily::RDNA3, ISAFamily::RDNA4,
-                          ISAFamily::GFX1250},
+  if (llvm::is_contained({ISAFamily::RDNA1, ISAFamily::RDNA2, ISAFamily::RDNA3,
+                          ISAFamily::RDNA4, ISAFamily::GFX1250},
                          targetInfo.getISAFamily())) {
     flags |= (1 << 24);
     uint32_t oob = 3;
-- 
