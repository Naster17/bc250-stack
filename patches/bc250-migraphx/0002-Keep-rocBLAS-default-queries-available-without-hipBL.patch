From 622ea3f2ad8f1baa8a44edb4f1e07cbe6e532c83 Mon Sep 17 00:00:00 2001
From: Naster17 <naster17.dev@gmail.com>
Date: Sun, 25 Oct 2026 00:39:08 +0200
Subject: [PATCH 2/5] Keep rocBLAS default queries available without hipBLASLt

---
 src/targets/gpu/device_name.cpp               | 17 +++++++-
 .../gpu/include/migraphx/gpu/device_name.hpp  |  2 -
 test/gpu/device_name.cpp                      | 40 +++++++++++++++++++
 3 files changed, 56 insertions(+), 3 deletions(-)
 create mode 100644 test/gpu/device_name.cpp

diff --git a/src/targets/gpu/device_name.cpp b/src/targets/gpu/device_name.cpp
index 70aa0f40a..a321a1d36 100644
--- a/src/targets/gpu/device_name.cpp
+++ b/src/targets/gpu/device_name.cpp
@@ -130,13 +130,28 @@ static bool gfx_default_rocblas_impl(const std::string& gfx_name)
                 : (gfx_name == "gfx90a"));
 }
 
-bool gfx_default_rocblas() { return gfx_default_rocblas_impl(get_gfx_name(get_device_name())); }
+#endif
+
+bool gfx_default_rocblas()
+{
+#if MIGRAPHX_USE_HIPBLASLT
+    return gfx_default_rocblas_impl(get_gfx_name(get_device_name()));
+#else
+    return true;
+#endif
+}
 
 bool gfx_default_rocblas(const context& ctx)
 {
+#if MIGRAPHX_USE_HIPBLASLT
     return gfx_default_rocblas_impl(get_gfx_name(ctx.get_current_device().get_device_name()));
+#else
+    (void)ctx;
+    return true;
+#endif
 }
 
+#if MIGRAPHX_USE_HIPBLASLT
 static bool hipblaslt_supported_impl(const std::string& gfx_name)
 {
     return (gfx_name == "gfx90a" or (starts_with(gfx_name, "gfx94") and gfx_name >= "gfx942") or
diff --git a/src/targets/gpu/include/migraphx/gpu/device_name.hpp b/src/targets/gpu/include/migraphx/gpu/device_name.hpp
index 7d8f9652e..a51f77142 100644
--- a/src/targets/gpu/include/migraphx/gpu/device_name.hpp
+++ b/src/targets/gpu/include/migraphx/gpu/device_name.hpp
@@ -55,10 +55,8 @@ MIGRAPHX_GPU_EXPORT bool gfx_has_mx_intrinsics(const context& ctx);
 
 MIGRAPHX_GPU_EXPORT bool gfx_has_fp8fnuz_support();
 
-#if MIGRAPHX_USE_HIPBLASLT
 MIGRAPHX_GPU_EXPORT bool gfx_default_rocblas();
 MIGRAPHX_GPU_EXPORT bool gfx_default_rocblas(const context& ctx);
-#endif
 
 MIGRAPHX_GPU_EXPORT bool hipblaslt_supported();
 MIGRAPHX_GPU_EXPORT bool hipblaslt_supported(const context& ctx);
diff --git a/test/gpu/device_name.cpp b/test/gpu/device_name.cpp
new file mode 100644
index 000000000..dfb421abd
--- /dev/null
+++ b/test/gpu/device_name.cpp
@@ -0,0 +1,40 @@
