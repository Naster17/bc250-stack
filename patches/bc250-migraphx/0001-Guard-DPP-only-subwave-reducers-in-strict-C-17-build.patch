Subject: [PATCH 1/5] Guard DPP-only subwave reducers in strict C++17 builds

---
 .../include/migraphx/kernels/reduce.hpp       |  3 ++
 test/gpu/kernels/reduce_no_dpp.cpp            | 36 +++++++++++++++++++
 2 files changed, 39 insertions(+)
 create mode 100644 test/gpu/kernels/reduce_no_dpp.cpp

diff --git a/src/targets/gpu/kernels/include/migraphx/kernels/reduce.hpp b/src/targets/gpu/kernels/include/migraphx/kernels/reduce.hpp
index 3b3aec4a7..8a88fa3c8 100644
--- a/src/targets/gpu/kernels/include/migraphx/kernels/reduce.hpp
+++ b/src/targets/gpu/kernels/include/migraphx/kernels/reduce.hpp
@@ -996,6 +996,8 @@ struct block_strided
     }
 };
 
+// Subwave reducers require the DPP implementation declared above.
+#if MIGRAPHX_HAS_DPP
 template <unsigned int SubWaveSize>
 struct subwave
 {
@@ -1075,6 +1077,7 @@ struct subwave
 };
 
 using wave = subwave<MIGRAPHX_WAVEFRONTSIZE>;
+#endif
 
 struct lane
 {
diff --git a/test/gpu/kernels/reduce_no_dpp.cpp b/test/gpu/kernels/reduce_no_dpp.cpp
new file mode 100644
index 000000000..58953768a
--- /dev/null
+++ b/test/gpu/kernels/reduce_no_dpp.cpp
@@ -0,0 +1,36 @@
