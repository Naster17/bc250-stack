Subject: [PATCH 7/8] Include iostream directly for RCCL DDA IPC diagnostics

The no-tracing build no longer imports iostream transitively through nvtx.h. ipc_init.cu uses std::cerr and must include its declaration directly. Preserve the imported CRLF line endings.
---
 projects/rccl/src/algorithms/dda/ipc/ipc_init.cu | 1 +
 1 file changed, 1 insertion(+)

diff --git a/projects/rccl/src/algorithms/dda/ipc/ipc_init.cu b/projects/rccl/src/algorithms/dda/ipc/ipc_init.cu
index 73faafd67d..f442cdbf1b 100644
--- a/projects/rccl/src/algorithms/dda/ipc/ipc_init.cu
+++ b/projects/rccl/src/algorithms/dda/ipc/ipc_init.cu
@@ -15,6 +15,7 @@
 #include "algorithms/dda/ipc/ipc_mem_handler.h"
 
 #include <cuda_runtime.h>
+#include <iostream>
 
 using nccl_dda_detail::DdaIpcBarrierState;
 using nccl_dda_detail::ddaMaxNBlocksForScratch;
