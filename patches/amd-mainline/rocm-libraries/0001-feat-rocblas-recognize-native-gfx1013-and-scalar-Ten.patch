From 55e9abea68b05cc524274d5806ebd8812005b383 Mon Sep 17 00:00:00 2001
From: Naster17 <naster17.dev@gmail.com>
Date: Sun, 11 Oct 2026 13:08:27 +0200
Subject: [PATCH] feat(rocblas): recognize native gfx1013 and scalar Tensile
 capabilities

---
 projects/rocblas/library/src/handle.cpp       |  4 ++
 .../rocblas/library/src/include/handle.hpp    |  1 +
 projects/rocblas/library/src/tensile_host.cpp |  4 ++
 .../HostLibraryTests/Predicates_test.cpp      | 12 +++++
 shared/tensile/Tensile/AsmCaps.py             | 49 +++++++++++++++++++
 shared/tensile/Tensile/Common.py              |  3 +-
 .../Source/lib/include/Tensile/AMDGPU.hpp     |  7 +++
 .../include/Tensile/PlaceholderLibrary.hpp    |  5 +-
 .../Tensile/Serialization/Predicates.hpp      |  1 +
 .../tensile/Tensile/Tests/unit/test_Common.py | 14 ++++++
 10 files changed, 98 insertions(+), 2 deletions(-)

diff --git a/projects/rocblas/library/src/handle.cpp b/projects/rocblas/library/src/handle.cpp
index fcef08d9662..3f1ac48b60d 100644
--- a/projects/rocblas/library/src/handle.cpp
+++ b/projects/rocblas/library/src/handle.cpp
@@ -417,6 +417,10 @@ Processor _rocblas_handle::getActiveArch()
     {
         return Processor::gfx1012;
     }
+    else if(deviceString.find("gfx1013") != std::string::npos)
+    {
+        return Processor::gfx1013;
+    }
     else if(deviceString.find("gfx1030") != std::string::npos)
     {
         return Processor::gfx1030;
diff --git a/projects/rocblas/library/src/include/handle.hpp b/projects/rocblas/library/src/include/handle.hpp
index 9e4ca9ec768..f2aaff96724 100644
--- a/projects/rocblas/library/src/include/handle.hpp
+++ b/projects/rocblas/library/src/include/handle.hpp
@@ -88,6 +88,7 @@ enum class Processor : int
     gfx1010 = 1010,
     gfx1011 = 1011,
     gfx1012 = 1012,
+    gfx1013 = 1013,
     gfx1030 = 1030,
     gfx1031 = 1031,
     gfx1032 = 1032,
diff --git a/projects/rocblas/library/src/tensile_host.cpp b/projects/rocblas/library/src/tensile_host.cpp
index a399c9f9826..3d983cc8290 100644
--- a/projects/rocblas/library/src/tensile_host.cpp
+++ b/projects/rocblas/library/src/tensile_host.cpp
@@ -279,6 +279,10 @@ namespace
         {
             return Tensile::LazyLoadingInit::gfx1012;
         }
+        else if(deviceString.find("gfx1013") != std::string::npos)
+        {
+            return Tensile::LazyLoadingInit::gfx1013;
+        }
         else if(deviceString.find("gfx1030") != std::string::npos)
         {
             return Tensile::LazyLoadingInit::gfx1030;
diff --git a/shared/tensile/HostLibraryTests/Predicates_test.cpp b/shared/tensile/HostLibraryTests/Predicates_test.cpp
index d2f2cd839f7..b398cf308c3 100644
--- a/shared/tensile/HostLibraryTests/Predicates_test.cpp
+++ b/shared/tensile/HostLibraryTests/Predicates_test.cpp
@@ -27,6 +27,18 @@
 #include <gtest/gtest.h>
 
 #include <Tensile/ContractionProblemPredicates.hpp>
+#include <Tensile/AMDGPU.hpp>
+#include <Tensile/PlaceholderLibrary.hpp>
+
+TEST(Predicates, NativeCyanSkillfishIdentity)
+{
+    using namespace Tensile;
+    AMDGPU gpu;
+    EXPECT_EQ(AMDGPU::Processor::gfx1013, gpu.toProcessorId("gfx1013:xnack-"));
+    EXPECT_EQ("gfx1013", AMDGPU::toString(AMDGPU::Processor::gfx1013));
+    EXPECT_EQ("TensileLibrary_*_gfx1013", RegexPattern(LazyLoadingInit::gfx1013));
+    EXPECT_EQ(AMDGPU::Processor::gfx1012, gpu.toProcessorId("gfx1012:xnack-"));
+}
 
 TEST(Predicates, ArithmeticIntensity)
 {
diff --git a/shared/tensile/Tensile/AsmCaps.py b/shared/tensile/Tensile/AsmCaps.py
index b3503840b40..a309d1d170a 100644
--- a/shared/tensile/Tensile/AsmCaps.py
+++ b/shared/tensile/Tensile/AsmCaps.py
@@ -1377,4 +1377,53 @@ def getCapabilitiesCache(rocmVersion: NamedTuple) -> dict:
 
         nested_update_(cachedAsmCaps, v19_diff)
 
+    # gfx1013 capabilities independently probed with LLVM 23.1.1.
+    # The generator re-probes them using the selected ROCm assembler.
+    cachedAsmCaps[(10, 1, 3)] = {
+        'HasAddLshl': True,
+        'HasAtomicAdd': False,
+        'HasDirectToLdsDest': False,
+        'HasDirectToLdsNoDest': True,
+        'HasExplicitCO': True,
+        'HasExplicitNC': True,
+        'HasGLCModifier': True,
+        'HasLshlOr': True,
+        'HasMFMA': False,
+        'HasMFMA_b8': False,
+        'HasMFMA_bf16_1k': False,
+        'HasMFMA_bf16_original': False,
+        'HasMFMA_constSrc': False,
+        'HasMFMA_f64': False,
+        'HasMFMA_f8': False,
+        'HasMFMA_i8_908': False,
+        'HasMFMA_i8_940': False,
+        'HasMFMA_vgpr': False,
+        'HasMFMA_xf32': False,
+        'HasNTModifier': False,
+        'HasSMulHi': True,
+        'HasWMMA': False,
+        'KernargPreloading': False,
+        'MaxLgkmcnt': 15,
+        'MaxVmcnt': 63,
+        'SupportedISA': True,
+        'SupportedSource': True,
+        'VOP3v_dot4_i32_i8': False,
+        'v_dot2_f32_f16': False,
+        'v_dot2c_f32_f16': False,
+        'v_dot4_i32_i8': False,
+        'v_dot4c_i32_i8': False,
+        'v_fma_f16': True,
+        'v_fma_f32': True,
+        'v_fma_f64': True,
+        'v_fma_mix_f32': True,
+        'v_fmac_f16': False,
+        'v_fmac_f32': True,
+        'v_mac_f16': False,
+        'v_mac_f32': True,
+        'v_mad_mix_f32': False,
+        'v_mov_b64': False,
+        'v_pk_fma_f16': True,
+        'v_pk_fmac_f16': False,
+    }
+
     return cachedAsmCaps
