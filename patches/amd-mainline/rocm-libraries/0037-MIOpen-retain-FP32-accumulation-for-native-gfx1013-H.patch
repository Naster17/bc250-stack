From 96e5a7dfc43356b1c9789a84ae9d79d41bbb0ad7 Mon Sep 17 00:00:00 2001
From: Naster17 <naster17.dev@gmail.com>
Date: Fri, 30 Oct 2026 00:21:58 +0100
Subject: [PATCH 37/38] MIOpen: retain FP32 accumulation for native gfx1013
 HIP-direct forward

---
 projects/miopen/src/kernels/MIOpenConvDirUniHip.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/projects/miopen/src/kernels/MIOpenConvDirUniHip.cpp b/projects/miopen/src/kernels/MIOpenConvDirUniHip.cpp
index c7c6d704337..2bd29efaa13 100644
--- a/projects/miopen/src/kernels/MIOpenConvDirUniHip.cpp
+++ b/projects/miopen/src/kernels/MIOpenConvDirUniHip.cpp
@@ -11,7 +11,10 @@
 // Since float_types.h has enabled true mixed precision for all
 // direct kernels, this kernel needs to retain its older behavior as it is
 // dependent upon tunability which isn't slated for MIOpen 2.0 PR #1725
-#if MIOPEN_USE_FP16 == 1
+// Native gfx1013 forward uses the mixed-precision accumulator from float_types.h.
+// The legacy half accumulator loses accuracy on ordinary non-dyadic inputs.
+// Keep the historical behavior for other devices and backward kernels.
+#if MIOPEN_USE_FP16 == 1 && !(defined(__gfx1013__) && MLO_DIR_FORWARD == 1)
 #undef FLOAT_ACCUM
 #define FLOAT_ACCUM FLOAT
 #define CVT_FLOAT2ACCUM(x) ((FLOAT_ACCUM)(x))
-- 
2.56.0

