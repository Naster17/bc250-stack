From c29021b40e758abd3fa97e3c8bddb7f091dd29d2 Mon Sep 17 00:00:00 2001
From: Naster17 <naster17.dev@gmail.com>
Date: Sun, 18 Oct 2026 22:26:16 +0200
Subject: [PATCH] docs(rocrand): correct LFSR113 C API offset support

---
 projects/rocrand/library/include/rocrand/rocrand.h   | 7 +++----
 projects/rocrand/library/include/rocrand/rocrand.hpp | 2 +-
 2 files changed, 4 insertions(+), 5 deletions(-)

diff --git a/projects/rocrand/library/include/rocrand/rocrand.h b/projects/rocrand/library/include/rocrand/rocrand.h
index 1d9ac64c999..89c64c9a4b9 100644
--- a/projects/rocrand/library/include/rocrand/rocrand.h
+++ b/projects/rocrand/library/include/rocrand/rocrand.h
@@ -649,8 +649,8 @@ rocrand_status ROCRANDAPI rocrand_set_seed_uint4(rocrand_generator generator, ui
  * - This operation resets the generator's internal state.
  * - This operation does not change the generator's seed.
  *
- * Absolute offset cannot be set if generator's type is ROCRAND_RNG_PSEUDO_MTGP32 or
- * ROCRAND_RNG_PSEUDO_LFSR113.
+ * Absolute offset cannot be set if generator's type is ROCRAND_RNG_PSEUDO_MTGP32.
+ * LFSR113 supports absolute offsets through this C API.
  *
  * \param generator Random number generator
  * \param offset New absolute offset
@@ -658,8 +658,7 @@ rocrand_status ROCRANDAPI rocrand_set_seed_uint4(rocrand_generator generator, ui
  * \return
  * - ROCRAND_STATUS_NOT_CREATED if the generator wasn't created \n
  * - ROCRAND_STATUS_SUCCESS if offset was successfully set \n
- * - ROCRAND_STATUS_TYPE_ERROR if generator's type is ROCRAND_RNG_PSEUDO_MTGP32 or
- * ROCRAND_RNG_PSEUDO_LFSR113
+ * - ROCRAND_STATUS_TYPE_ERROR if generator's type is ROCRAND_RNG_PSEUDO_MTGP32
  */
 rocrand_status ROCRANDAPI rocrand_set_offset(rocrand_generator  generator,
                                              unsigned long long offset);
diff --git a/projects/rocrand/library/include/rocrand/rocrand.hpp b/projects/rocrand/library/include/rocrand/rocrand.hpp
index 6f1538580dc..effe99f1958 100644
--- a/projects/rocrand/library/include/rocrand/rocrand.hpp
+++ b/projects/rocrand/library/include/rocrand/rocrand.hpp
@@ -1853,7 +1853,7 @@ public:

     /// \brief Constructs the pseudo-random number engine.
     ///
-    /// LFSR113 does not accept offset.
+    /// This C++ wrapper does not expose generator offsets.
     ///
     /// \param seed_value seed value to use in the initialization of the internal state, see also seed()
     /// \param order_value ordering of the sequences generated by the engine, see also order()
