From ade6fcc1ae7574b2f5ad285c8a2c592af1e3e99c Mon Sep 17 00:00:00 2001
From: Naster17 <naster17.dev@gmail.com>
Date: Fri, 23 Oct 2026 11:31:50 +0200
Subject: [PATCH 18/23] Use BF16 scalar storage for NCCL PreMulSum

The BF16 branch instantiated unpackPreMulSum with float. NCCL/RCCL reads a
scalar in the reduction dtype: the host case read the low two bytes of a
float (zero for 2.0), and the device case requested a float pointer from a
BF16 tensor. Instantiate with at::BFloat16 and include BF16 in the existing
PreMulSum collective test loop.

Test Plan:
The isolated native gfx1013 RCCL Torch baseline reproduces the wrong BF16
host-scalar output after 31 passing device/backend/SUM/FP16 checks. Kernel
logs remain unchanged. The fixed isolated native rebuild and GPU rerun are
pending; qualification is recorded separately in the workspace evidence.

```sh
PYTORCH_LINT_SKIP_CODEGEN=1 uv run --offline --no-project --python 3.12 --with spin==0.18 spin lint -- -a --take=CLANGFORMAT,NEWLINE,INCLUDE,RUFF,FLAKE8,PYFMT,TESTOWNERS,TEST_HAS_MAIN torch/csrc/distributed/c10d/ProcessGroupNCCL.cpp test/distributed/test_c10d_ops_nccl.py
```

Targeted static/format linters pass. Authored with an AI assistant.
---
 test/distributed/test_c10d_ops_nccl.py           | 2 +-
 torch/csrc/distributed/c10d/ProcessGroupNCCL.cpp | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/test/distributed/test_c10d_ops_nccl.py b/test/distributed/test_c10d_ops_nccl.py
index 3daf424..38df418 100644
--- a/test/distributed/test_c10d_ops_nccl.py
+++ b/test/distributed/test_c10d_ops_nccl.py
@@ -197,7 +197,7 @@ class ProcessGroupNCCLOpTest(MultiProcContinuousTest):
 
         # Premul Sum
         if torch.cuda.nccl.version() >= (2, 11, 1):
-            for dtype in torch.half, torch.float, torch.double:
+            for dtype in torch.half, torch.bfloat16, torch.float, torch.double:
                 for factor in (
                     3.0,
                     torch.tensor([5.0], device=local_device_id, dtype=dtype),
diff --git a/torch/csrc/distributed/c10d/ProcessGroupNCCL.cpp b/torch/csrc/distributed/c10d/ProcessGroupNCCL.cpp
index 7eee36c..e6be6d7 100644
--- a/torch/csrc/distributed/c10d/ProcessGroupNCCL.cpp
+++ b/torch/csrc/distributed/c10d/ProcessGroupNCCL.cpp
@@ -115,7 +115,7 @@ ncclRedOpRAII getNcclReduceOp(
         case ncclFloat:
           return unpackPreMulSum<float, ncclFloat>(reduceOp, comm);
         case ncclBfloat16:
-          return unpackPreMulSum<float, ncclBfloat16>(reduceOp, comm);
+          return unpackPreMulSum<at::BFloat16, ncclBfloat16>(reduceOp, comm);
         case ncclDouble:
           return unpackPreMulSum<double, ncclDouble>(reduceOp, comm);
         default:
