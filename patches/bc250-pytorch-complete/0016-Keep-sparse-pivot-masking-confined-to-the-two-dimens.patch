From dc8fea0cb8b157cb415359033e4f0175d2ebfa56 Mon Sep 17 00:00:00 2001
From: Naster17 <naster17.dev@gmail.com>
Date: Sun, 18 Oct 2026 21:20:08 +0200
Subject: [PATCH 16/22] Keep sparse pivot masking confined to the
 two-dimensional solve path

---
 aten/src/ATen/native/sparse/cuda/SparseBlas.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/aten/src/ATen/native/sparse/cuda/SparseBlas.cpp b/aten/src/ATen/native/sparse/cuda/SparseBlas.cpp
index f96c627..a33ac84 100644
--- a/aten/src/ATen/native/sparse/cuda/SparseBlas.cpp
+++ b/aten/src/ATen/native/sparse/cuda/SparseBlas.cpp
@@ -282,7 +282,8 @@ std::tuple<Tensor&, Tensor&> triangular_solve_out_sparse_csr_cuda(
     Tensor& clone_A) {
   sparse::impl::cuda::triangular_solve_out_sparse_csr(A, B, X, upper, transpose, unitriangular);
 #ifdef USE_ROCM
-  if (!unitriangular && X.numel() != 0 && A._nnz() != 0) {
+  if (!unitriangular && A.dim() == 2 && X.dim() == 2 &&
+      X.numel() != 0 && A._nnz() != 0) {
     sparse::impl::cuda::apply_sparse_triangular_solve_pivot_mask(A, X);
   }
 #endif
