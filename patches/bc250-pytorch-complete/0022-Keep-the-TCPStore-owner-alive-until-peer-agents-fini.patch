From 8d8b18df558cb478727ba2179f2e01dfce20ea40 Mon Sep 17 00:00:00 2001
From: Naster17 <naster17.dev@gmail.com>
Date: Wed, 4 Nov 2026 15:43:12 +0100
Subject: [PATCH 22/23] Keep the TCPStore owner alive until peer agents finish
 exit reads

The symmetric terminal barrier can return on rank zero before another agent issues its final wait. Use the existing rank-aware synchronize/get_all completion protocol so the TCPStore daemon outlives peer reads.

Test Plan: D05 CPU-only real TCPStore reproduces the original close race and passes two candidate repetitions plus exit-flag/timeout unit cases. Full upstream CI was not run.
---
 test/distributed/elastic/agent/server/test/api_test.py |  6 ++++--
 torch/distributed/elastic/agent/server/api.py          | 10 ++++++++--
 2 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/test/distributed/elastic/agent/server/test/api_test.py b/test/distributed/elastic/agent/server/test/api_test.py
index c36474a..9e8de27 100644
--- a/test/distributed/elastic/agent/server/test/api_test.py
+++ b/test/distributed/elastic/agent/server/test/api_test.py
@@ -493,6 +493,7 @@ class SimpleElasticAgentTest(unittest.TestCase):
         agent = TestAgent(spec)
         agent._worker_group.state = WorkerState.SUCCEEDED
         agent._worker_group.group_world_size = 1
+        agent._worker_group.group_rank = 0
         agent._store = MagicMock()
 
         flag_during_barrier = []
@@ -501,7 +502,7 @@ class SimpleElasticAgentTest(unittest.TestCase):
             flag_during_barrier.append(agent._in_exit_barrier)
 
         with patch(
-            "torch.distributed.elastic.utils.store.barrier",
+            "torch.distributed.elastic.utils.store.synchronize",
             side_effect=mock_barrier,
         ):
             agent._exit_barrier()
@@ -517,10 +518,11 @@ class SimpleElasticAgentTest(unittest.TestCase):
         agent = TestAgent(spec)
         agent._worker_group.state = WorkerState.SUCCEEDED
         agent._worker_group.group_world_size = 1
+        agent._worker_group.group_rank = 0
         agent._store = MagicMock()
 
         with patch(
-            "torch.distributed.elastic.utils.store.barrier",
+            "torch.distributed.elastic.utils.store.synchronize",
             side_effect=Exception("wait timeout"),
         ):
             agent._exit_barrier()
diff --git a/torch/distributed/elastic/agent/server/api.py b/torch/distributed/elastic/agent/server/api.py
index c1b39fc..c237355 100644
--- a/torch/distributed/elastic/agent/server/api.py
+++ b/torch/distributed/elastic/agent/server/api.py
@@ -991,11 +991,17 @@ class SimpleElasticAgent(ElasticAgent):
         start = time.time()
         self._in_exit_barrier = True
         try:
-            store_util.barrier(
+            # The rank-zero agent owns the TCPStore daemon. A symmetric barrier
+            # can let it close the store before a peer issues its final wait.
+            # synchronize/get_all keeps rank zero alive until peers have finished
+            # their store reads; only rank zero waits on the final completion key.
+            store_util.synchronize(
                 store=self._store,
+                data=b"",
+                rank=self._worker_group.group_rank,
                 world_size=self._worker_group.group_world_size,
                 key_prefix=_TERMINAL_STATE_SYNC_ID,
-                barrier_timeout=self._exit_barrier_timeout,
+                timeout=self._exit_barrier_timeout,
             )
             logger.info(
                 "Done waiting for other agents. Elapsed: %s seconds",
-- 
